{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        ".agents/skills/*/scripts/main.ts",
        ".agents/skills/*/scripts/checkContentReads.ts",
        "tests/**/*.test.ts",
        ".agents/skills/*/scripts/**/*.test.ts"
      ],
      "project": [
        "scripts/*.mjs",
        "tests/**/*.ts",
        ".agents/skills/*/scripts/**/*.ts"
      ],
      "ignoreDependencies": [
        "@decocms/blocks",
        "@decocms/apps-algolia",
        "@decocms/apps-shopify",
        "@decocms/apps-vtex",
        "@decocms/compat-v7",
        "@decocms/nextjs",
        "@decocms/tanstack",
        "react",
        "react-dom"
      ]
    },
    "packages/*": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "examples/*": {
      "ignore": [
        "**"
      ]
    },
    "packages/blocks": {
      "project": [
        "src/**/*.{ts,tsx}",
        "bin/*.js"
      ],
      "ignoreDependencies": [
        "esbuild",
        "@opentelemetry/api"
      ],
      "entry": [
        "src/v8/cli/main.ts",
        "src/v8/cli/__tests__/folderCdn.ts",
        "src/v8/analytics/runtime/src/index.ts",
        "src/v8/analytics/runtime/modules/*.ts",
        "src/v8/analytics/runtime/view/*.ts",
        "src/v8/analytics/shared/*.ts"
      ]
    },
    "packages/compat-v7": {
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignore": [
        "src/__fixtures__/v7/**"
      ]
    }
  },
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "packages/compat-v7/src/clx.ts": [
      "duplicates"
    ]
  }
}
