{
  "name": "@decocms/apps-wake",
  "version": "0.0.0",
  "type": "module",
  "description": "Thin Wake Commerce Storefront API client for Deco sites",
  "repository": {
    "type": "git",
    "url": "https://github.com/decocms/blocks.git",
    "directory": "packages/apps-wake"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/__tests__"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./storefront": "./src/storefront.ts",
    "./storefront/types": "./src/storefrontTypes.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/apps-wake/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@decocms/blocks": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
