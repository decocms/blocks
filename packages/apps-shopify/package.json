    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/apps-shopify/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@decocms/blocks": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
