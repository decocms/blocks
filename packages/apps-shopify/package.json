{
  "name": "@decocms/apps-shopify",
  "version": "0.0.0",
  "type": "module",
  "description": "Thin Shopify Storefront API client for Deco sites",
  "repository": {
    "type": "git",
    "url": "https://github.com/decocms/blocks.git",
    "directory": "packages/apps-shopify"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/__tests__"
