{
	"name": "@decocms/native",
	"version": "0.0.0",
	"type": "module",
	"description": "Deco binding for React Native / Expo \u2014 renders CMS pages from the ?renderJson page-as-JSON endpoint served by the site's worker.",
	"repository": {
		"type": "git",
		"url": "https://github.com/decocms/blocks.git",
		"directory": "packages/native"
	},
	"license": "MIT",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./setup": "./src/setup.ts",
		"./push": "./src/push.ts"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run --root ../.. packages/native/",
		"typecheck": "tsc --noEmit",
		"lint:unused": "knip"
	},
	"dependencies": {
		"@decocms/blocks": "workspace:*",
		"@decocms/blocks-cli": "workspace:*",
		"tsx": "^4.22.5"
	},
	"peerDependencies": {
		"react": "^19.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"knip": "^5.86.0",
		"typescript": "^5.9.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"bin": {
		"deco-native": "./src/cli.ts"
	}
}
