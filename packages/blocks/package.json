{
	"name": "@decocms/blocks",
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"description": "Deco CMS: content resolution, built-in blocks, the deco CLI and the content protocol",
	"repository": {
		"type": "git",
		"url": "https://github.com/decocms/blocks.git",
		"directory": "packages/blocks"
	},
	"main": "./src/index.ts",
	"files": [
		"bin",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/__tests__",
		"!src/**/__fixtures__",
		"!src/**/__conformance__",
		"!src/v8/testFixtures.ts"
	],
	"bin": {
		"deco": "./bin/deco.js"
	},
	"exports": {
		".": "./src/index.ts",
		"./analytics": "./src/v8/analytics.ts",
		"./cli": "./src/v8/cli/index.ts",
		"./fetch": "./src/v8/fetch.ts",
		"./secrets": "./src/v8/secrets.ts",
		"./protocol": "./src/protocol/index.ts",
		"./protocol/keys": "./src/protocol/keys.ts",
		"./protocol/server": "./src/protocol/server/index.ts",
		"./protocol/storage/fs": {
			"node": "./src/protocol/storage/fs/index.ts",
			"default": "./src/protocol/storage/fs/unsupported.ts"
		},
		"./protocol/conformance": "./src/protocol/conformance/index.ts"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run --root ../.. packages/blocks/",
		"typecheck": "tsc --noEmit",
		"lint:unused": "knip"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"tsx": "^4.22.5",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"typescript": "^5.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"esbuild": "^0.27.3",
		"knip": "^5.86.0",
		"react-dom": "^19.0.0",
		"typescript": "^5.9.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	}
}
