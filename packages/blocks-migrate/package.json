{
	"name": "@decocms/blocks-migrate",
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"description": "One-time migration of a v7 Deco site to the next major: block map with legacy aliases, vendored loaders, content in .deco/blocks, secret re-encryption and an import report",
	"repository": {
		"type": "git",
		"url": "https://github.com/decocms/blocks.git",
		"directory": "packages/blocks-migrate"
	},
	"main": "./src/index.ts",
	"files": [
		"bin",
		"src",
		"!src/**/*.test.ts"
	],
	"bin": {
		"blocks-migrate": "./bin/blocks-migrate.js"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run --root ../.. packages/blocks-migrate/",
		"typecheck": "tsc --noEmit",
		"lint:unused": "knip"
	},
	"dependencies": {
		"@decocms/blocks": "workspace:*",
		"tsx": "^4.22.5",
		"typescript": "^5.9.3"
	},
	"devDependencies": {
		"knip": "^5.86.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	}
}
